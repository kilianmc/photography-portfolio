---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WorkCard from "../components/WorkCard.astro";
import Photo from "../components/Photo.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { frontmatter as about } from "../content/about.md";
import { frontmatter as home } from "../content/home.md";
import { sortWorks, exhibitionStatus } from "../lib/collections";

// The hero image is CMS-managed via home.md frontmatter. Resolve its path (e.g.
// ../assets/home/hero.jpg) to an optimisable image — keys match because
// home.md and this file both sit one level under src/.
const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/**/*.{jpeg,jpg,png,webp,avif,JPEG,JPG,PNG,WEBP,AVIF}",
  { eager: true },
);
const heroImg = home.heroImage
  ? assetImages[home.heroImage]?.default
  : undefined;

const works = sortWorks(
  (await getCollection("works")).filter((w) => !w.data.draft),
);
const featuredWorks = works.filter((w) => w.data.featured).slice(0, 3);

const collections = (await getCollection("collections")).filter(
  (c) => !c.data.draft,
);
const featured = collections.find((c) => c.data.featured) ?? collections[0];
const status = featured ? exhibitionStatus(featured) : null;
---

<BaseLayout title="Laia — Fotografia" description={about.statement}>
  <Header />

  <section class="hero">
    <div class="hero-photo">
      {heroImg && (
        <Image
          src={heroImg}
          alt={home.heroAlt ?? "Retrat a contrallum amb flors"}
          widths={[800, 1200, 1800]}
          sizes="100vw"
          loading="eager"
        />
      )}
    </div>
    <div class="hero-caption">
      <h1>Laia</h1>
      <p>{about.statement}</p>
    </div>
  </section>

  <main>
    <section class="section">
      <div class="section-head">
        <h2 data-i18n="selected_works">Obres seleccionades</h2>
        <a href="/works" data-i18n="view_all">
          Veure-les totes →
        </a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-8 lg:grid-cols-3">
        {featuredWorks.map((w, i) => (
          <WorkCard work={w} loading={i === 0 ? "eager" : "lazy"} />
        ))}
      </div>
    </section>

    <section class="section bio-section">
      <div class="bio">
        <h2>{about.city}</h2>
        <p>{home.intro}</p>
        <a class="more" href="/about" data-i18n="read_more">
          Llegir més
        </a>
      </div>
    </section>

    {featured && (
      <section class="section">
        <div class="section-head">
          <h2 data-i18n="collections">Col·leccions</h2>
          <a href="/collections" data-i18n="view_all">
            Veure-les totes →
          </a>
        </div>
        <a class="feature" href={`/collections/${featured.id}`}>
          <Photo
            src={featured.data.coverImage}
            alt={featured.data.coverAlt}
            ratio="3 / 2"
            sizes="(max-width: 760px) 100vw, 60vw"
          />
          <div>
            {status === "current" && (
              <span class="badge" data-i18n="current">
                Exposició actual
              </span>
            )}
            <h3>{featured.data.title}</h3>
            {(featured.data.city || featured.data.startDate) && (
              <p class="where">
                {[featured.data.city, featured.data.startDate?.getFullYear()]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
            )}
            {featured.data.description && <p>{featured.data.description}</p>}
          </div>
        </a>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: min(88vh, 900px);
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-bone-2);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.28) saturate(1.12) contrast(1.02) brightness(1.02);
  }
  .hero-caption {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(2rem, 6vh, 5rem);
    color: #fbf6ee;
    text-shadow: 0 1px 30px rgba(34, 30, 25, 0.35);
  }
  .hero-caption h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
  }
  .hero-caption p {
    font-style: italic;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1rem, 2.2vw, 1.5rem);
    margin-top: 0.75rem;
    opacity: 0.92;
  }

  .section {
    padding: clamp(3.5rem, 9vw, 7rem) var(--gutter);
  }
  .bio-section {
    background: var(--color-bone-2);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: 1rem;
  }
  .section-head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
  }
  .section-head a {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .section-head a:hover {
    color: var(--color-terracotta);
  }

  .bio {
    max-width: 46ch;
    margin: 0 auto;
    text-align: center;
  }
  .bio h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 1.5rem;
  }
  .bio p {
    color: var(--color-ink-soft);
    font-size: 1.05rem;
  }
  .bio .more {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-terracotta);
    padding-bottom: 3px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .feature {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .feature .badge {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin-bottom: 1rem;
  }
  .feature h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.05;
    margin-bottom: 0.75rem;
  }
  .feature .where {
    color: var(--color-ink-soft);
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }
  .feature p {
    color: var(--color-ink-soft);
  }
  @media (max-width: 760px) {
    .feature {
      grid-template-columns: 1fr;
    }
  }
</style>
