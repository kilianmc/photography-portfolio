---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WorkCard from "../../components/WorkCard.astro";
import { getCollection } from "astro:content";
import {
  sortWorks,
  exhibitionStatus,
  isExhibition,
} from "../../lib/collections";

export async function getStaticPaths() {
  const collections = (await getCollection("collections")).filter(
    (c) => !c.data.draft,
  );
  return collections.map((collection) => ({
    params: { slug: collection.id },
    props: { collection },
  }));
}

const { collection } = Astro.props;
const d = collection.data;

const works = sortWorks(
  (await getCollection("works")).filter(
    (w) => !w.data.draft && w.data.collection.id === collection.id,
  ),
);

const status = exhibitionStatus(collection);
const exhibition = isExhibition(collection);
const dates = [d.startDate, d.endDate]
  .filter((x): x is Date => Boolean(x))
  .map((x) =>
    x.toLocaleDateString("ca-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }),
  )
  .join(" – ");
const place = [d.location, d.city].filter(Boolean).join(", ");
---

<BaseLayout title={`${d.title} — Laia`} description={d.description ?? d.title}>
  <Header />

  <main class="mx-auto max-w-6xl px-[var(--gutter)] py-16 md:py-24">
    <nav class="crumb">
      <a href="/collections">← Col·leccions</a>
    </nav>

    <header class="intro">
      {exhibition && status && (
        <span
          class="badge"
          data-i18n={status === "current" ? "current" : undefined}
        >
          {status === "current" ? "Exposició actual" : "Exposició passada"}
        </span>
      )}
      <h1>{d.title}</h1>
      {place && <p class="where">{place}</p>}
      {dates && <p class="dates">{dates}</p>}
      {d.description && <p class="desc">{d.description}</p>}
    </header>

    {works.length > 0 ? (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-8 lg:grid-cols-3">
        {works.map((w, i) => (
          <WorkCard work={w} loading={i < 3 ? "eager" : "lazy"} />
        ))}
      </div>
    ) : (
      <p class="empty">Encara no hi ha obres en aquesta col·lecció.</p>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  .crumb {
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin-bottom: 2rem;
  }
  .crumb a {
    color: inherit;
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--color-terracotta);
  }
  .intro {
    max-width: 46ch;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .badge {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin-bottom: 1rem;
  }
  .intro h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
  }
  .intro .where {
    margin-top: 0.75rem;
    color: var(--color-ink);
  }
  .intro .dates {
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin-top: 0.2rem;
  }
  .intro .desc {
    margin-top: 1.5rem;
    color: var(--color-ink-soft);
  }
  .empty {
    color: var(--color-ink-soft);
  }
</style>
