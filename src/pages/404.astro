---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Pàgina no trobada — Laia"
  description="Aquesta pàgina no existeix."
>
  <Header />

  <main class="wrap">
    <p class="code">404</p>
    <h1>Aquesta pàgina s'ha perdut entre llums i flors.</h1>
    <a class="home" href="/">← Tornar a l'inici</a>
  </main>

  <Footer />
</BaseLayout>

<style>
  .wrap {
    max-width: 40rem;
    margin: 0 auto;
    padding: clamp(4rem, 14vw, 9rem) var(--gutter);
    text-align: center;
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(3rem, 12vw, 6rem);
    color: var(--color-terracotta);
    line-height: 1;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(1.25rem, 3.5vw, 1.9rem);
    margin-top: 1rem;
  }
  .home {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-terracotta);
    padding-bottom: 3px;
    text-decoration: none;
  }
</style>
