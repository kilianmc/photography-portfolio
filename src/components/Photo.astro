---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio for the frame, e.g. "4 / 5" (portrait) or "3 / 2". */
  ratio?: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt,
  ratio = "4 / 5",
  sizes = "(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw",
  widths = [400, 800, 1200],
  loading = "lazy",
  class: className,
} = Astro.props;
---

<!--
  Shared image frame. The warm sepia/contrast filter + gradient overlay unify
  every photograph into the gallery's palette (mockup). All optimisation is
  Astro's `astro:assets` defaults — no Sharp config (spec §7).
-->
<div class:list={["photo", className]} style={`aspect-ratio: ${ratio}`}>
  <Image src={src} alt={alt} sizes={sizes} widths={widths} loading={loading} />
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: var(--color-bone-2);
    border-radius: 2px;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.28) saturate(1.15) contrast(1.02) brightness(1.02);
    transition:
      transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 900ms ease;
  }
  .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(180, 112, 63, 0.05),
      rgba(34, 30, 25, 0.1)
    );
    pointer-events: none;
  }
</style>
