---
import type { CollectionEntry } from "astro:content";
import Photo from "./Photo.astro";

interface Props {
  work: CollectionEntry<"works">;
  loading?: "lazy" | "eager";
}

const { work, loading = "lazy" } = Astro.props;
---

<a class="work" href={`/works/${work.id}`}>
  <Photo
    src={work.data.coverImage}
    alt={work.data.coverAlt}
    ratio="4 / 5"
    loading={loading}
  />
  <div class="meta">
    <span class="title">{work.data.title}</span>
    <span class="year">{work.data.year}</span>
  </div>
</a>

<style>
  .work {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .work:hover :global(.photo img) {
    transform: scale(1.04);
    filter: sepia(0.2) saturate(1.2) brightness(1.04);
  }
  .meta {
    margin-top: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .work:hover .meta,
  .work:focus-visible .meta {
    opacity: 1;
    transform: none;
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .year {
    color: var(--color-ink-soft);
    font-size: 0.85rem;
  }
  /* Touch/no-hover devices: always show the caption. */
  @media (hover: none) {
    .meta {
      opacity: 1;
      transform: none;
    }
  }
</style>
